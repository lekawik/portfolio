---
interface Props {
    title: string;
    techs: string[];
    description: string;
    period: string;
    imagePath: string;
    url: string;
}

const { title, techs, description, period, imagePath, url } = Astro.props;
---

<a href={url} class="w-fit h-fit">
    <div class="border border-gray">
        <div class="bg-background-secondary dark:bg-background-secondary-dark">
            <img src={imagePath} alt="" loading="lazy" decoding="async" class="w-full max-h-72 object-contain" />
        </div>

        <div class="border-t border-gray"></div>

        <ul class="flex flex-wrap gap-x-3 gap-y-1 py-1 px-4">
            {
                techs.map((tech) => (
                    <li class="text-body text-secondary-text dark:text-secondary-text-dark font-mono">
                        {tech}
                    </li>
                ))
            }
        </ul>

        <div class="border-t border-gray"></div>

        <div class="py-2 px-4 flex flex-col space-y-1">
            <p class="text-title2 font-bold text-primary-text dark:text-primary-text-dark">
                {title}
            </p>
            <p class="text-body text-secondary-text dark:text-secondary-text-dark">
                {description}
            </p>
            <p class="text-sm font-mono text-secondary-text dark:text-secondary-text-dark">
                {period}
            </p>
        </div>

        <div class="px-4 pb-4">
            <div class="border w-fit border-gray px-4 py-1">
                <p class="text-title3 text-primary-text dark:text-primary-text-dark">Lire</p>
            </div>
        </div>
    </div>
</a>
